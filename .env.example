HTTP_PORT=8080
TASK_TRACKER_PROVIDER=jira
SPRINT_DAYS_REMAINING=3

EMPLOYEES_FILE=config/employees.json
TEAM_ID=backend
OPENAPI_PATH=api/openapi.yaml

# Auth (начальник — один аккаунт)
JWT_SECRET=change-me-in-production
MANAGER_FILE=data/manager.json

# PostgreSQL (optional; without it chat is in-memory from Telegram)
POSTGRES_DSN=

# Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_API=
JIRA_SPRINT_ID=
JIRA_PROJECT_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
