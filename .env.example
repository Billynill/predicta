HTTP_PORT=8080
DEMO_MODE=true
TASK_TRACKER_PROVIDER=mock
SPRINT_DAYS_REMAINING=3

# Команда: id + jira external_id + telegram (см. config/employees.example.json)
EMPLOYEES_FILE=config/employees.json
TEAM_ID=backend

# PostgreSQL (optional for demo)
POSTGRES_DSN=postgres://predicta:predicta@localhost:5432/predicta?sslmode=disable

# Jira (TASK_TRACKER_PROVIDER=jira, DEMO_MODE=false)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# альтернативное имя переменной для токена:
JIRA_API=
JIRA_SPRINT_ID=
# если sprint id не задан — берётся active sprint с доски проекта:
JIRA_PROJECT_KEY=

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_SPRINT_ID=

# Telegram (create bot via @BotFather, add to group, disable privacy: /setprivacy -> Disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GigaChat (Authorization key = Base64 from Sber Studio)
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
